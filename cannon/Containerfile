# Stage 1: Build stage using official Golang alpine image
FROM golang:1.26-alpine AS builder

WORKDIR /src

# Copy go.mod first
COPY go.mod ./
RUN go mod download

# Copy source code and build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/cannon ./cmd/cannon/main.go

# Stage 2: Runtime stage
FROM alpine:3.20

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app

COPY --from=builder /app/cannon /app/cannon
RUN chown appuser:appgroup /app/cannon

USER appuser

EXPOSE 8083

ENTRYPOINT ["/app/cannon"]
