# Stage 1: Build stage
FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/probe main.go

# Stage 2: Runtime stage
FROM alpine:3.20

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app

COPY --from=builder /app/probe /app/probe
RUN chown appuser:appgroup /app/probe

USER appuser

EXPOSE 8082

ENTRYPOINT ["/app/probe"]
